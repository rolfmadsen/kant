{
  "xgauntlet": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "xgauntlet hook antigravity",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "xgauntlet telemetry --format antigravity-hook"
      }
    ]
  }
}